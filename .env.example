# ==============================================================================
# Vercel & Client Environment Variables (.env.example)
# ==============================================================================
# WARNING: Never commit real API keys or secrets to version control.
# Set these variables securely in your Vercel Project Settings -> Environment Variables.

# ------------------------------------------------------------------------------
# 1. Cloudflare Turnstile (Anti-Bot CAPTCHA)
# ------------------------------------------------------------------------------
# Public Site Key (exposed to browser client)
VITE_TURNSTILE_SITE_KEY=

# Private Secret Key (Serverless Function ONLY - never prefix with VITE_)
TURNSTILE_SECRET_KEY=

# ------------------------------------------------------------------------------
# 2. Resend Email Service (Serverless Function ONLY)
# ------------------------------------------------------------------------------
# Obtain from https://resend.com/api-keys
RESEND_API_KEY=

# Destination email where client inquiries will be delivered (default fallback: kajaltech75@gmail.com)
CONTACT_TO_EMAIL=kajaltech75@gmail.com

# ------------------------------------------------------------------------------
# 3. Upstash Redis Rate Limiting (Optional - Serverless Function ONLY)
# ------------------------------------------------------------------------------
# Obtain from https://console.upstash.com
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
